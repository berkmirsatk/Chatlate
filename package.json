{
  "name": "chatlate",
  "version": "1.2.1",
  "author": "@berkmirsatk",
  "description": "Chat translation for Inugram with formatting preserved.",
  "scripts": {
    "check": "tsc --noEmit && inu check --no-typecheck",
    "build": "inu build",
    "test": "node --test tests/*.test.cjs",
    "test:extera": "python3 -m unittest discover -s extera -p \"test_*.py\"",
    "format": "prettier --write src scripts tests inu.config.ts",
    "format:check": "prettier --check src scripts tests inu.config.ts",
    "verify": "npm run format:check && npm run check && npm run build && npm test && npm run test:extera",
    "package": "node scripts/package.cjs",
    "notes": "esbuild scripts/release-notes.js --bundle --platform=node --format=cjs --outfile=dist/release-notes.cjs && node dist/release-notes.cjs"
  },
  "type": "commonjs",
  "devDependencies": {
    "@inugram/cli": "49.0.0",
    "@inugram/plugin-types": "49.0.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "private": true,
  "license": "GPL-3.0-only"
}
